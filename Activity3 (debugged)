#include <stdio.h>

int main()
{
    char customerName[50];
    int customerID;
    char membership;

    float product1, product2, product3;

    int quantity = 3;
    float subtotal;
    float average;

    printf("ONLINE ORDER BILL\n");
    printf("-----------------\n");

    printf("Enter customer name: ");
    fgets(customerName, sizeof(customerName), stdin);

    printf("Enter customer ID: ");
    scanf("%d", &customerID);

    printf("Enter membership type (R/G): ");
    scanf(" %c", &membership);

    printf("Enter price of Product 1: ");
    scanf("%f", &product1);

    printf("Enter price of Product 2: ");
    scanf("%f", &product2);

    printf("Enter price of Product 3: ");
    scanf("%f", &product3);

    printf("\nORDER RECEIPT\n");
    printf("================\n");

    printf("Customer Name: %s\n", customerName);
    printf("Customer ID: %d\n", customerID);
    printf("Membership: %c\n", membership);

    printf("Product 1: %.1f\n", product1);
    printf("Product 2: %.1f\n", product2);
    printf("Product 3: %.1f\n", product3);

    printf("Quantity: %d\n", quantity);

    printf("--------------------------\n");

    printf("--------------------------\n");
    
    subtotal = product1 + product2 + product3;
    average = subtotal / 3;
    printf("Subtotal: %.2f\n", subtotal);
    printf("Average Price: %.1f\n", average);

    return 0;
}
