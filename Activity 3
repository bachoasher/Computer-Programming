#include <stdio.h>

int main()
{
    char customerName[30];
    int customerID;
    char membership;

    float product1; product2; product3;

    int quantity;
    float subtotal;
    float average;

    printf("ONLINE ORDER BILL\n");
    printf("-----------------\n");

    printf("Enter customer name: ");
    scanf("%d", customerName);

    printf("Enter customer ID: ");
    scanf("%f", &customerID);

    printf("Enter membership type (R/G): ");
    scanf("%s", &membership);

    printf("Enter price of Product 1: ");
    scanf("%d", &product1);

    printf("Enter price of Product 2: ");
    scanf("%f", product2);

    printf("Enter price of Product 3: ");
    scanf("%f", &product3);

    printf("\nORDER RECEIPT\n");
    printf("================\n");

    printf("Customer Name: %d\n", customerName);
    printf("Customer ID: %f\n", customerID);
    printf("Membership: %d\n", membership);

    printf("Product 1: %d\n", product1);
    printf("Product 2: %.2f\n", product2);
    printf("Product 3: %.2f\n", product3);

    printf("Quantity: %.2f\n", quantity);

    printf("--------------------------\n");

    printf("--------------------------\n");

    printf("Subtotal: %.2f\n", subtotal);
    printf("Average Price: %d\n", average);

    return 0;
}
